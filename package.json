{
  "name": "facturacion-backend",
  "version": "1.0.0",
  "description": "Atajos para correr el backend (Spring Boot). Envuelve a Maven.",
  "scripts": {
    "dev": "./mvnw spring-boot:run",
    "start": "./mvnw spring-boot:run",
    "build": "./mvnw clean package -DskipTests",
    "jar": "./mvnw clean package -DskipTests && java -jar target/facturacion-backend-0.0.1-SNAPSHOT.jar",
    "stop": "lsof -ti:8080 | xargs kill -9 || true"
  }
}
