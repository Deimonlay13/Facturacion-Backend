{
  "info": {
    "name": "Facturación Backend - Colección completa",
    "description": "Colección actualizada para probar el backend completo: empresa, roles, auth, clientes, productos, CAF/folios y documentos DTE. Orden recomendado: Setup -> Auth -> Clientes -> Productos -> Folios -> Documentos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runSuffix')) {",
          "  const suffix = String(Date.now()).slice(-6);",
          "  pm.collectionVariables.set('runSuffix', suffix);",
          "  function rut(base) {",
          "    const n = String(base + Number(suffix));",
          "    let sum = 0;",
          "    let mul = 2;",
          "    for (let i = n.length - 1; i >= 0; i--) {",
          "      sum += Number(n[i]) * mul;",
          "      mul = mul === 7 ? 2 : mul + 1;",
          "    }",
          "    const r = 11 - (sum % 11);",
          "    const dv = r === 11 ? '0' : r === 10 ? 'K' : String(r);",
          "    return `${n}-${dv}`;",
          "  }",
          "  pm.collectionVariables.set('empresaRut', rut(77000000));",
          "  pm.collectionVariables.set('clienteRut', rut(78000000));",
          "  pm.collectionVariables.set('username', `qa_${suffix}`);",
          "  pm.collectionVariables.set('password', 'Pass1234!');",
          "  pm.collectionVariables.set('productoCodigo', `PROD-${suffix}`);",
          "  pm.collectionVariables.set('caf33Desde', String(910000 + Number(suffix) % 1000));",
          "  pm.collectionVariables.set('caf33Hasta', String(910002 + Number(suffix) % 1000));",
          "  pm.collectionVariables.set('caf52Desde', String(920000 + Number(suffix) % 1000));",
          "  pm.collectionVariables.set('caf52Hasta', String(920001 + Number(suffix) % 1000));",
          "  pm.collectionVariables.set('caf61Desde', String(930000 + Number(suffix) % 1000));",
          "  pm.collectionVariables.set('caf61Hasta', String(930001 + Number(suffix) % 1000));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "empresaId", "value": "" },
    { "key": "clienteId", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "documentoId", "value": "" },
    { "key": "detalleId", "value": "" },
    { "key": "guiaId", "value": "" },
    { "key": "notaCreditoId", "value": "" },
    { "key": "runSuffix", "value": "" },
    { "key": "empresaRut", "value": "" },
    { "key": "clienteRut", "value": "" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "productoCodigo", "value": "" },
    { "key": "caf33Desde", "value": "" },
    { "key": "caf33Hasta", "value": "" },
    { "key": "caf52Desde", "value": "" },
    { "key": "caf52Hasta", "value": "" },
    { "key": "caf61Desde", "value": "" },
    { "key": "caf61Hasta", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Tipos documento",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tipos-documento"
          }
        },
        {
          "name": "Listar roles",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/roles"
          }
        },
        {
          "name": "Crear rol QA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"QA_{{runSuffix}}\",\n  \"nombreMostrar\": \"QA {{runSuffix}}\",\n  \"descripcion\": \"Rol de prueba\"\n}"
            }
          }
        },
        {
          "name": "Crear empresa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('empresaId', json.id);",
                  "pm.test('empresa creada', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/empresas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rutEmpresa\": \"{{empresaRut}}\",\n  \"razonSocial\": \"QA Empresa {{runSuffix}}\",\n  \"nombreFantasia\": \"QA\",\n  \"giro\": \"Software\",\n  \"direccion\": \"Av QA 123\",\n  \"ciudad\": \"Santiago\",\n  \"comuna\": \"Providencia\",\n  \"pais\": \"Chile\",\n  \"telefono\": \"+56911111111\",\n  \"sitioWeb\": \"https://qa.local\",\n  \"emailPrincipal\": \"qa@example.com\",\n  \"emailContabilidad\": \"contabilidad@example.com\",\n  \"rutRepresentante\": \"11111111-1\",\n  \"nombreRepresentante\": \"Representante QA\",\n  \"telefonoRepresentante\": \"+56922222222\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
