# Copia este archivo a .env y completa con tus valores reales.
# .env está en .gitignore y NO se sube al repo.

# Conexión a la BD para los scripts de respaldo (pg_dump / pg_restore).
# En AWS EC2 con Docker Compose, usa localhost porque la DB se expone en el host.
DB_URL=postgresql://facturacion_user:facturacion@localhost:5432/facturacion?sslmode=disable

# Variables de entorno para Docker Compose / EC2
# Nota: en Docker Compose la app se conecta a Postgres usando el servicio `db`.
# El archivo .env usa valores locales para tu host; docker-compose fuerza el host interno `db`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/facturacion
SPRING_DATASOURCE_USERNAME=facturacion_user
SPRING_DATASOURCE_PASSWORD=facturacion
JWT_SECRET=ReemplazaConUnSecretoSeguro
SRE_API_TOKEN=ReemplazaConTuTokenSRE

# --- Render (external DB) example ---
# If you deploy to Render (managed DB), set these environment variables in
# the Render dashboard (do NOT commit secrets to the repo). Example values
# are shown for structure only — replace with your actual values in Render.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:5432/<DATABASE>
# SPRING_DATASOURCE_USERNAME=<USERNAME>
# SPRING_DATASOURCE_PASSWORD=<PASSWORD>
# Example (do NOT commit this line; set it in Render UI):
# SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-d8o1t90g4nts73c6mup0-a.oregon-postgres.render.com:5432/facturacion_1654
# SPRING_DATASOURCE_USERNAME=gdl
# SPRING_DATASOURCE_PASSWORD=<your-render-password>
